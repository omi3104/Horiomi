# ---------------------------------------------------------------------------
# Copy this file to ".env" for LOCAL runs. In GitHub Actions these are set as
# repository secrets instead (Settings -> Secrets and variables -> Actions).
# Every value below is free to obtain. See README.md for step-by-step links.
# ---------------------------------------------------------------------------

# REQUIRED -------------------------------------------------------------------

# Google AI Studio -> "Get API key"  (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Cloud OAuth client (Desktop app) + refresh token from scripts/get-token.mjs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# OPTIONAL (media). If a key is missing that source is skipped; Pollinations
# (keyless AI images) is always available as the final fallback. -------------

# https://www.pexels.com/api/  -> free API key
PEXELS_API_KEY=

# https://pixabay.com/api/docs/  -> free API key (shown when logged in)
PIXABAY_API_KEY=

# OPTIONAL (delivery / tuning) ---------------------------------------------

# Google Drive folder ID to drop finished video + script into for review.
# It's the long id in the folder URL: drive.google.com/drive/folders/<THIS>
DRIVE_FOLDER_ID=

# edge-tts voice. List them with:  edge-tts --list-voices
VOICE=en-US-AndrewNeural

# Region for trending signals (ISO country code)
GEO=US

# YouTube category id. 27 = Education, 28 = Science & Technology, 24 = Entertainment
YT_CATEGORY_ID=27

# Upload privacy: private | unlisted | public   (you asked for private)
PRIVACY=private

# faster-whisper model: tiny | base | small | medium  (small = good balance)
WHISPER_MODEL=small

# Force a specific topic instead of auto-picking (handy for a test run)
TOPIC_OVERRIDE=
