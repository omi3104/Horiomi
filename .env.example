# ---------------------------------------------------------------------------
# Copy this file to ".env" for LOCAL runs. In GitHub Actions these are set as
# repository secrets instead (Settings -> Secrets and variables -> Actions).
# Every value below is free to obtain. See README.md for step-by-step links.
# ---------------------------------------------------------------------------

# REQUIRED -----------------------------------------------------------------
# The ONLY required credentials. Google Cloud OAuth client (Desktop app) plus a
# refresh token minted once by scripts/get-token.mjs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# OPTIONAL (media quality) -----------------------------------------------
# All free. If a key is missing that source is skipped. Pollinations (keyless
# AI images) is always the final fallback, so the pipeline runs with none set -
# but WITHOUT at least one stock-video key every beat is a still image.

# https://www.pexels.com/api/            -> real stock VIDEO + photos (best single key)
PEXELS_API_KEY=

# https://pixabay.com/api/docs/          -> extra stock video + photos
PIXABAY_API_KEY=

# https://api.coverr.co  (Dashboard -> API keys)  -> cinematic free stock video
COVERR_API_KEY=

# https://console.groq.com/keys          -> script writer (tried first; fast, free)
GROQ_API_KEY=

# https://aistudio.google.com/apikey     -> script fallback + AI images
GEMINI_API_KEY=

# OPTIONAL (delivery / tuning) -----------------------------------------

# Google Drive folder ID to drop finished video + script into for review.
# It's the long id in the folder URL: drive.google.com/drive/folders/<THIS>
DRIVE_FOLDER_ID=

# edge-tts voice. List them with:  edge-tts --list-voices
VOICE=en-US-AndrewNeural

# Region for trending signals (ISO country code)
GEO=US

# YouTube category id. 27 = Education, 28 = Science & Technology, 24 = Entertainment
YT_CATEGORY_ID=27

# Upload privacy: private | unlisted | public
PRIVACY=private

# faster-whisper model: tiny | base | small | medium  (small = good balance)
WHISPER_MODEL=small

# Caption height above the bottom edge, in px (PlayResY is 1920). Higher = further
# up. ~380 keeps them clear of the YouTube Shorts UI.
CAPTION_MARGIN_V=380

# Force a specific topic instead of auto-picking (handy for a test run)
TOPIC_OVERRIDE=

# --- length control ---------------------------------------------------
# Every finished short is forced inside this window (seconds).
TARGET_SECONDS_MIN=50
TARGET_SECONDS_MAX=80
# Optional: exact aim point (defaults to the midpoint, 65).
TARGET_SECONDS=
# Add stock VIDEO clips as a supplement (needs a Pexels/Pixabay key). Off by
# default - a history channel wants relevant images, not generic motion.
PREFER_VIDEO=false

# --- branding ---------------------------------------------------------
CHANNEL_NAME=Horiomi
# Recurring AI host portrait on the intro/outro cards (identity only, not
# lip-synced). Pin a face by committing assets/presenter.png.
PRESENTER=false
PRESENTER_SEED=77

# --- editing polish -------------------------------------------------
# Thin progress bar along the bottom.
PROGRESS_BAR=true
# Soft whoosh on every image cut.
SFX=true
# Background music: "ambient" (a soft generated drone) or "off". A file you
# drop in assets/music/*.mp3 always wins over the generated bed.
MUSIC=ambient
MUSIC_VOLUME=0.10
